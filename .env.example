NODE_ENV=development
PORT=3333
DATABASE_URL="postgresql://planner:planner@127.0.0.1:5433/planner?schema=public"

# Gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_DAYS=30

# Google OAuth (console.cloud.google.com → Credenciais → OAuth 2.0)
# Redirect URI autorizada: http://localhost:3333/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/api/auth/google/callback

FRONTEND_URL=http://localhost:5173

# Origens separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Resend (API) — vazio = e-mails apenas logados no console (sem envio real)
RESEND_API_KEY=
MAIL_FROM="plann.er <no-reply@planner.local>"
