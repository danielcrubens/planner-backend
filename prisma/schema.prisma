generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255) // null quando a conta usa só Google/magic link
  googleId     String?  @unique @map("google_id")
  trips        Trip[]   @relation("TripOwner")
  participations Participant[]
  invitesSent  Participant[] @relation("InvitedBy")
  refreshTokens  RefreshToken[]
  resetTokens    PasswordResetToken[]
  loginTokens    LoginToken[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Trip {
  id          String   @id @default(uuid()) @db.Uuid
  destination String   @db.VarChar(255)
  startsAt    DateTime @map("starts_at") @db.Date
  endsAt      DateTime @map("ends_at") @db.Date
  owner       User     @relation("TripOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String   @map("owner_id") @db.Uuid
  participants Participant[]
  activities  Activity[]
  links       Link[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("trips")
}

model Participant {
  id              String    @id @default(uuid()) @db.Uuid
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId          String    @map("trip_id") @db.Uuid
  email           String    @db.VarChar(255)
  name            String?   @db.VarChar(120)
  isOwner         Boolean   @default(false) @map("is_owner")
  isConfirmed     Boolean   @default(false) @map("is_confirmed")
  account         User?     @relation(fields: [accountId], references: [id])
  accountId       String?   @map("account_id") @db.Uuid
  invitedBy       User?     @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedById     String?   @map("invited_by_id") @db.Uuid
  inviteTokenHash String?   @unique @map("invite_token_hash") @db.VarChar(255)
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz(6)
  inviteUsedAt    DateTime? @map("invite_used_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([tripId, email])
  @@index([accountId])
  @@map("participants")
}

model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String   @map("trip_id") @db.Uuid
  title     String   @db.VarChar(255)
  occursAt  DateTime @map("occurs_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tripId, occursAt])
  @@map("activities")
}

model Link {
  id        String   @id @default(uuid()) @db.Uuid
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String   @map("trip_id") @db.Uuid
  title     String   @db.VarChar(255)
  url       String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tripId])
  @@map("links")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginToken {
  id        String    @id @default(uuid()) @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  redirect  String?   @db.VarChar(500)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("login_tokens")
}
